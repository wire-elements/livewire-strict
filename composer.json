{
    "name": "wire-elements/livewire-strict",
    "description": "Add strict mode to Livewire.",
    "require": {
        "php": "^8.2|^8.3|^8.4"
    },
    "license": "MIT",
    "autoload": {
        "psr-4": {
            "WireElements\\LivewireStrict\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Tests\\": "tests/"
        }
    },
    "authors": [
        {
            "name": "Philo Hermans",
            "email": "me@philo.dev"
        }
    ],
    "extra": {
        "laravel": {
            "providers": [
                "WireElements\\LivewireStrict\\LivewireStrictServiceProvider"
            ]
        }
    },
    "minimum-stability": "dev",
    "prefer-stable": true,
    "scripts": {
        "test": "vendor/bin/phpunit"
    },
    "require-dev": {
        "phpunit/phpunit": "^10.5|^11.0|^12.0",
        "laravel/framework": "^10.15.0|^11.0|^12.0|^13.0",
        "orchestral/testbench": "^8.21.0|^9.1|^10.0|^11.0",
        "livewire/livewire": "^3.5|^4.0"
    }
}
